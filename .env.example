# MongoDB Connection String (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adamjee-db?retryWrites=true&w=majority

# JWT Settings
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# AI Chatbot & Description Generator API Key (OpenRouter or OpenAI)
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_or_openai_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app

# Safepay Payment Gateway (Optional)
SAFEPAY_MODE=sandbox
SAFEPAY_SECRET_KEY=
SAFEPAY_PUBLIC_KEY=
